@{
    ViewData["Title"] = "Welcome";
}

<style>
    .hero-section {
        background: linear-gradient(to right, #3a7bd5, #00d2ff);
        color: white;
        padding: 100px 0;
        text-align: center;
        border-radius: 10px;
    }

    .hero-title {
        font-size: 48px;
        font-weight: 700;
    }

    .hero-subtitle {
        font-size: 20px;
        margin-bottom: 30px;
    }

    .btn-custom {
        padding: 12px 30px;
        font-size: 18px;
        margin: 5px;
        border-radius: 30px;
    }
</style>

<div class="container mt-5">
    <div class="hero-section shadow-lg">
        <h1 class="hero-title">Welcome to JobBoardPlatform</h1>
        <p class="hero-subtitle">Connecting Employers and Job Seekers across industries</p>
    </div>

    <div class="row mt-5 text-center">
        <div class="col-md-4">
            <h4>For Job Seekers</h4>
            <p>Search and apply to your dream jobs. Upload your resume and get noticed.</p>
        </div>
        <div class="col-md-4">
            <h4>For Employers</h4>
            <p>Post jobs and find qualified candidates. Manage applications with ease.</p>
        </div>
        <div class="col-md-4">
            <h4>Secure and Simple</h4>
            <p>Our platform uses secure authentication and an easy-to-use interface.</p>
        </div>
    </div>
</div>
