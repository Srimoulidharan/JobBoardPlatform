@using JobBoardPlatform.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    var adminName = Context.Session.GetString("UserName") ?? "Admin";
}
<h2 class="mb-3">Welcome, <span class="text-primary fw-bold">@adminName</span></h2>
<p class="text-muted">Here you can view all users and job postings.</p
<!-- USERS TABLE -->
<div class="mb-5">
    <h3>Manage Users</h3>
    <table class="table table-striped table-bordered align-middle shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in ViewBag.Users as List<User>)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <h3>All Job Listings</h3>
    <table class="table table-striped table-bordered align-middle shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>Title</th>
                <th>Employer</th>
                <th>Location</th>
                <th>Posted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in ViewBag.Jobs as List<JobPost>)
            {
                <tr>
                    <td>@job.Title</td>
                    <td>@job.Employer.FullName</td>
                    <td>@job.Location</td>
                    <td>@job.PostedDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
</div>
